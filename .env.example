# Copy to .env.local for local development, and add the same names in
# Vercel → Project → Settings → Environment Variables. Never commit real values.
# Anything prefixed NEXT_PUBLIC_ is shipped to the browser; everything else stays server-side.

# Required for AI features (landmark scanner, Guess Boston judge, hints, debrief). Server only.
# Create one at https://aistudio.google.com/apikey. Never give it a NEXT_PUBLIC_ prefix.
GEMINI_API_KEY=

# Optional: text model override. Default: gemini-3.5-flash-lite, with automatic fallback on overload.
GEMINI_MODEL=

# Optional: model override for photo recognition only. Falls back to the text chain above.
GEMINI_VISION_MODEL=

# Optional: Google Maps browser key. Restrict it by HTTP referrer to your domains and limit it to
# "Maps JavaScript API" + "Places API". Without it the app uses its built-in schematic map.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional: free key from https://api-v3.mbta.com. Raises the 20 requests/minute keyless limit.
MBTA_API_KEY=

# Optional: both together enable the Supabase cloud mirror of guest progress.
# Requires "Allow anonymous sign-ins" in Supabase → Authentication → Sign In / Providers.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
